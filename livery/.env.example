# Copy to .env.local and fill in. Never commit real values.

# Hosted Chromium (Browserless) over CDP. Swap the URL to move hosts, no code change.
BROWSER_WS_ENDPOINT=

# Gemini, used to write kits from extracted values and screenshots
GEMINI_API_KEY=
GEMINI_MODEL=
# Optional: tried when the main model is overloaded or retired
GEMINI_FALLBACK_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sha256(ip + secret) for rate limits; raw IPs are never stored
IP_HASH_SECRET=

# Bump when extraction changes; part of the kit cache key
EXTRACTOR_VERSION=1
