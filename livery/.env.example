# Copy to .env.local and fill in. Never commit real values.

# Hosted Chromium over CDP. Browserless: wss://production-sfo.browserless.io?token=YOUR_TOKEN
# (the https://.../screenshot?token= REST URL also works; it is converted). Empty in dev = local Chrome.
BROWSER_WS_ENDPOINT=

# Gemini, used to write kits from extracted values and screenshots
GEMINI_API_KEY=
GEMINI_MODEL=
# Comma-separated models tried in order when the main one is busy or retired.
# Measured reliable on 2026-10-07: gemini-3-flash-preview,gemini-2.5-flash
GEMINI_FALLBACK_MODEL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# sha256(ip + secret) for rate limits; raw IPs are never stored
IP_HASH_SECRET=

# Bump when extraction changes; part of the kit cache key
EXTRACTOR_VERSION=1

# Vercel Cron sends this as a Bearer token to /api/cron/cleanup (16+ characters)
CRON_SECRET=

# Bearer token for /api/admin/takedown (16+ characters)
ADMIN_SECRET=
